{
  "manifest_version": 3,
  "name": "Bán Content — Cookie Gemini & ChatGPT",
  "version": "1.2.0",
  "description": "Lấy cookie đăng nhập gemini.google.com / chatgpt.com và đẩy sang Bán Content (kho riêng, cổng 8785/8786).",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://*.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Gemini/ChatGPT → CapCut TTS"
  }
}
